# Copy this file to .env and add your credentials.
# Example: cp env.sample .env
# Then edit .env with your real keys. Do not commit .env.
# =============================================================================

# --- Claude (Anthropic) — used for MODEL_PROVIDER=anthropic and v3 LLM extraction ---
ANTHROPIC_API_KEY=

# --- OpenAI — used for embeddings and when MODEL_PROVIDER=openai ---
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_API_VERSION=
OPENAI_DEPLOYMENT_NAME=

# --- Google Gemini — used for DOCS_PARSER=gemini and doc ingestion ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- WTO API (optional — for MFN rate lookups) ---
WTO_API_KEY=
WTO_SECONDARY_API_KEY=

# --- Provider / app settings (no secrets) ---
MODEL_PROVIDER=anthropic
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
MCP_TRANSPORT=stdio
DOCS_PARSER=gemini
WTO_TIMEOUT_SECONDS=20
HMRC_TIMEOUT_SECONDS=20
RATE_CACHE_TTL_SECONDS=86400
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_FAILURE_WINDOW_SECONDS=60
CIRCUIT_PROBE_TIMEOUT_SECONDS=30
VANIK_DOCS_DB=/tmp/vanik_docs.db

# --- Manifest Search: optional JSONL audit (raw → sanitised → entity-stripped → events) ---
# VANIK_SANITISATION_AUDIT_LOG=/var/log/vanik/sanitisation_audit.jsonl
