## Vidhi (विधि) — sample env (NO SECRETS)
## Copy values into your runtime env, e.g. /etc/vanik/secrets.env on the VPS.

# Gemini API key (Google AI Studio)
GEMINI_API_KEY=

# Optional: lock Gemini usage behind a code (shareable).
# If set, Gemini models require `access_code` in the request body to match.
VIDHI_GEMINI_UNLOCK_CODE=

# Optional: local LLaMA via Ollama (recommended default)
# Ollama server base URL (local on VPS if installed)
VIDHI_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default Ollama model (example)
VIDHI_OLLAMA_MODEL=llama3.1:8b

# Curated concept registries (phi1.yaml, phi2.yaml). Default: repo shared/concepts/
# VIDHI_CONCEPTS_DIR=/opt/akeru-dev/shared/concepts

# Architecture document (recommended: file path)
VIDHI_ARCH_DOC_PATH=/opt/akeru-dev/vidhi/vidhi_agent/vanik_architecture.txt

# Optional alternative: inline the document text (NOT recommended for large docs)
# VIDHI_ARCH_DOC=

