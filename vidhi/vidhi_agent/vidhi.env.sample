## Vidhi (विधि) — sample env (NO SECRETS)
## Copy values into your runtime env, e.g. /etc/vanik/secrets.env on the VPS.

# Gemini API key (Google AI Studio)
GEMINI_API_KEY=

# Architecture document (recommended: file path)
VIDHI_ARCH_DOC_PATH=/opt/akeru-dev/vidhi/vidhi_agent/vanik_architecture.txt

